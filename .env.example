# 關閉自動同步：設為 1
# SYNC_DISABLED=1

# 時區（預設 Asia/Taipei）
# SYNC_TZ=Asia/Taipei

# 自訂 cron，多組用分號分隔（預設：平日 18:00、18:30、19:00）
# SYNC_CRON=0 18 * * 1-5;30 18 * * 1-5;0 19 * * 1-5

# 快照／歷史日檔目錄（與程式發佈分離）
# 本機可不設 → 預設 <專案>/.cache
# 正式環境請指到持久磁碟，例如：
# CACHE_DIR=/data/cache

# Cloudflare R2（S3 相容）— 外掛快取，redeploy 後可還原
# 完整步驟見 R2_SETUP.md；四個必填都有才會啟用
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=jinliu-cache
# R2_PREFIX=jinliu-cache
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
